#!/bin/sh /etc/rc.common
# Copyright (C) 2026
# BIRD2 antifilter daemon init script.

START=95
STOP=10
USE_PROCD=1

BIRD=/usr/sbin/bird2
BIRDC=/usr/sbin/birdc
BIRD_CONF=/etc/bird/bird.conf
BIRD_RUN=/var/run/bird
RSC_DIR=/etc/bird/list_rsc
LIST_DIR=/etc/bird/list
VIA_IFACE=""

get_cfg() {
	uci -q get "bird.global.$1" 2>/dev/null
}

resolve_router_id() {
	local rid
	rid=$(get_cfg router_id)
	[ -n "$rid" ] && [ "$rid" != "auto" ] && {
		echo "$rid"
		return
	}

	# First global IPv4 address configured on the router is used.
	rid=$(ip -4 addr show scope global 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
	[ -n "$rid" ] && {
		echo "$rid"
		return
	}

	# Fallback: management / br-lan address.
	rid=$(uci -q get network.lan.ipaddr 2>/dev/null)
	[ -n "$rid" ] && {
		echo "$rid"
		return
	}

	echo "127.0.0.1"
}

# Generate the static protocol section with one route per rsc file.
gen_static() {
	local rsc
	[ -d "$RSC_DIR" ] || return
	for rsc in "$RSC_DIR"/*.rsc; do
		[ -f "$rsc" ] || continue
		echo "    include \"$rsc\";"
	done
}

gen_kernel() {
	# Export routes into the kernel routing table. Local listed routes stay
	# more specific than the default route, so traffic not in the lists keeps
	# going via WAN (default route is managed by OpenWrt itself).
	cat <<-EOF
		protocol kernel {
		    ipv4 {
		        import none;
		        export filter {
		            if proto = "static_antifilter" || proto = "bgp" then accept;
		            reject;
		        };
		    };
		}

		protocol kernel {
		    ipv6 { import none; export none; };
		}
	EOF
}

# Build one BGP protocol block depending on the peer role.
gen_bgp_peer() {
	local name role enabled neighbor remote_as local_ip passive nhs
	local cfg
	local sections
	sections=$(uci -q show bird 2>/dev/null | awk -F'[.=]' '/=bgp_peer$/{print $2}' | sort -u)

	for name in $sections; do
		enabled=$(uci -q get "bird.$name.enabled" 2>/dev/null)
		[ "$enabled" = "0" ] && continue
		role=$(uci -q get "bird.$name.role" 2>/dev/null)
		[ -n "$role" ] || role=server
		neighbor=$(uci -q get "bird.$name.neighbor" 2>/dev/null)
		[ -n "$neighbor" ] || continue
		remote_as=$(uci -q get "bird.$name.remote_as" 2>/dev/null)
		local_ip=$(uci -q get "bird.$name.local_ip" 2>/dev/null)
		passive=$(uci -q get "bird.$name.passive" 2>/dev/null)
		nhs=$(uci -q get "bird.$name.next_hop_self" 2>/dev/null)

		cat <<-EOF

		protocol bgp ${name} {
		    description "BIRD antifilter ${role} peer";
		EOF
		[ -n "$local_ip" ] && echo "    local ${local_ip} as ${remote_as:-0};"
		echo "    neighbor ${neighbor} as ${remote_as:-0};"
		[ -n "$local_ip" ] && echo "    source address ${local_ip};"
		if [ "$passive" = "1" ]; then
			echo "    passive on;"
		fi
		echo "    hold time 240;"
		echo "    ipv4 {"
		if [ "$role" = "client" ]; then
			echo "        import filter { accept; };"
			echo "        export filter { reject; };"
		else
			echo "        import none;"
			echo "        export filter {"
			echo "            if proto = \"static_antifilter\" then {"
			[ "$nhs" = "1" ] && echo "                next hop self;"
			echo "                accept;"
			echo "            }"
			echo "            reject;"
			echo "        };"
		fi
		echo "    };"
		echo "}"
	done
}

start_service() {
	setup_cron
	start_instance
}

start_instance() {
	local rid
	# VIA iface used by sync to build route lines.
	VIA_IFACE=$(get_cfg via_interface)
	[ -z "$VIA_IFACE" ] && VIA_IFACE="amneziawg0"

	rid=$(resolve_router_id)

	# Ensure a first sync so the rsc includes are meaningful.
	[ -n "$(ls "$RSC_DIR"/*.rsc 2>/dev/null)" ] || /usr/sbin/bird-sync.sh >/dev/null 2>&1

	# Regenerate rsc from custom lists if not present.
	[ -d "$RSC_DIR" ] || mkdir -p "$RSC_DIR"
	[ -d "$LIST_DIR" ] || mkdir -p "$LIST_DIR"
	>&2 echo "bird: router id = $rid"

	cat > "$BIRD_CONF" <<-EOF
		log syslog all;
		router id ${rid};

		protocol device {
		}

		protocol direct {
		    disabled;
		    ipv4;
		    ipv6;
		}

		$(gen_kernel)

		protocol static static_antifilter {
		    ipv4;
		$(gen_static)}
	EOF

	# Append BGP peers.
	gen_bgp_peer >> "$BIRD_CONF"

	procd_open_instance
	procd_set_param command "$BIRD" -c "$BIRD_CONF" -f
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	rc_command start
}

reload_service() {
	procd_kill bird 2>/dev/null
	start
}

status() {
	if [ -x "$BIRDC" ] && "$BIRDC" show uptime >/dev/null 2>&1; then
		"$BIRDC" show protocols
	else
		echo "BIRD is not running"
		return 1
	fi
}

sync() {
	/usr/sbin/bird-sync.sh
}

