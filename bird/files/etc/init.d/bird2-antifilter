#!/bin/sh /etc/rc.common
# Copyright (C) 2026
# BIRD2 antifilter daemon init script.

START=95
STOP=10
USE_PROCD=1

# Binary names differ between packages: the "bird2" package installs the
# daemon as /usr/sbin/bird (BIRD 2.x) and the control tool as /usr/sbin/birdc.
BIRD=/usr/sbin/bird
BIRDC=/usr/sbin/birdc
BIRD_CONF=/etc/bird/bird.conf
BIRD_PID=/var/run/bird.pid
RSC_DIR=/etc/bird/list_rsc
LIST_DIR=/etc/bird/list
VIA_IFACE=""

get_cfg() {
	uci -q get "bird.global.$1" 2>/dev/null
}

resolve_router_id() {
	local rid
	rid=$(get_cfg router_id)
	[ -n "$rid" ] && [ "$rid" != "auto" ] && {
		echo "$rid"
		return
	}
	# Prefer the LAN interface address (br-lan) so the router id stays
	# stable and local even when WWAN/WAN addresses change.
	for dev in br-lan lan; do
		rid=$(ip -4 addr show dev "$dev" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
		[ -n "$rid" ] && {
			echo "$rid"
			return
		}
	done
	# Fallback: management / br-lan address.
	rid=$(uci -q get network.lan.ipaddr 2>/dev/null | cut -d'/' -f1)
	[ -n "$rid" ] && {
		echo "$rid"
		return
	}
	echo "127.0.0.1"
}

# Generate the static v4 and v6 protocol sections. BIRD static instances
# support only one address family each, so the rsc files generated by the
# sync script are split into *.v4.rsc and *.v6.rsc. The includes are
# wildcards so newly generated/removed lists are picked up on the next
# `birdc configure` without regenerating bird.conf.
gen_static() {
	echo "protocol static static_antifilter4 {"
	echo "    ipv4;"
	echo '    include "/etc/bird/list_rsc/*.v4.rsc";'
	echo "}"
	echo ""
	echo "protocol static static_antifilter6 {"
	echo "    ipv6;"
	echo '    include "/etc/bird/list_rsc/*.v6.rsc";'
	echo "}"
}

gen_kernel() {
	# Export routes into the kernel routing table. Local listed routes stay
	# more specific than the default route, so traffic not in the lists keeps
	# going via WAN (default route is managed by OpenWrt itself).
	cat <<-EOF
		protocol kernel {
		    ipv4 {
		        import none;
		        export filter {
		            if proto = "static_antifilter4" || proto = "static_antifilter6" || proto = "bgp" then accept;
		            reject;
		        };
		    };
		}

		protocol kernel {
		    ipv6 {
		        import none;
		        export filter {
		            if proto = "static_antifilter6" || proto = "bgp" then accept;
		            reject;
		        };
		    };
		}
	EOF
}

# Build one BGP protocol block depending on the peer role.
# Supports per-peer: port, hold_time, password (MD5), export_kernel (client),
# and both IPv4/IPv6 channels.
gen_bgp_peer() {
	local name role enabled neighbor remote_as local_ip passive nhs ekpt
	local port hold_time password def_hold
	local sections
	sections=$(uci -q show bird 2>/dev/null | awk -F'[.=]' '/=bgp_peer$/{print $2}' | sort -u)

	def_hold=$(get_cfg hold_time)
	[ -n "$def_hold" ] || def_hold=240

	for name in $sections; do
		enabled=$(uci -q get "bird.$name.enabled" 2>/dev/null)
		[ "$enabled" = "0" ] && continue
		role=$(uci -q get "bird.$name.role" 2>/dev/null)
		[ -n "$role" ] || role=server
		neighbor=$(uci -q get "bird.$name.neighbor" 2>/dev/null)
		[ -n "$neighbor" ] || continue
		remote_as=$(uci -q get "bird.$name.remote_as" 2>/dev/null)
		local_ip=$(uci -q get "bird.$name.local_ip" 2>/dev/null)
		passive=$(uci -q get "bird.$name.passive" 2>/dev/null)
		nhs=$(uci -q get "bird.$name.next_hop_self" 2>/dev/null)
		ekpt=$(uci -q get "bird.$name.export_kernel" 2>/dev/null)
		port=$(uci -q get "bird.$name.port" 2>/dev/null)
		hold_time=$(uci -q get "bird.$name.hold_time" 2>/dev/null)
		[ -n "$hold_time" ] || hold_time="$def_hold"
		password=$(uci -q get "bird.$name.password" 2>/dev/null)

		cat <<-EOF

		protocol bgp ${name} {
		    description "BIRD antifilter ${role} peer";
		EOF
		[ -n "$local_ip" ] && echo "    local ${local_ip} as ${remote_as:-0};"
		echo "    neighbor ${neighbor} as ${remote_as:-0};"
		[ -n "$port" ] && echo "    port ${port};"
		[ -n "$local_ip" ] && echo "    source address ${local_ip};"
		if [ "$passive" = "1" ]; then
			echo "    passive on;"
		fi
		echo "    hold time ${hold_time};"
		if [ -n "$password" ]; then
			echo "    password \"${password}\";"
		fi
		# "next hop self" is a channel-level option (inside ipv4/ipv6{}).
		nhs_chan=""
		if [ "$nhs" = "1" ] && [ "$role" = "server" ]; then
			nhs_chan="        next hop self;"
		fi
		if [ "$role" = "client" ]; then
			# Client: import routes from upstream, install listed routes into
			# the kernel table (export to static_antifilter-derived routes).
			echo "    ipv4 {"
			echo "        import filter { accept; };"
			if [ "$ekpt" = "1" ]; then
				echo "        export filter {"
				echo "            if proto = \"static_antifilter4\" || proto = \"static_antifilter6\" then accept;"
				echo "            reject;"
				echo "        };"
			else
				echo "        export filter { reject; };"
			fi
			echo "    };"
			echo "    ipv6 {"
			echo "        import filter { accept; };"
			if [ "$ekpt" = "1" ]; then
				echo "        export filter {"
				echo "            if proto = \"static_antifilter6\" then accept;"
				echo "            reject;"
				echo "        };"
			else
				echo "        export filter { reject; };"
			fi
			echo "    };"
		else
			# Server: advertise the listed static routes to the peer.
			echo "    ipv4 {"
			[ -n "$nhs_chan" ] && echo "$nhs_chan"
			echo "        import none;"
			echo "        export filter {"
			echo "            if proto = \"static_antifilter4\" || proto = \"static_antifilter6\" then {"
			echo "                accept;"
			echo "            }"
			echo "            reject;"
			echo "        };"
			echo "    };"
			echo "    ipv6 {"
			[ -n "$nhs_chan" ] && echo "$nhs_chan"
			echo "        import none;"
			echo "        export filter {"
			echo "            if proto = \"static_antifilter6\" then {"
			echo "                accept;"
			echo "            }"
			echo "            reject;"
			echo "        };"
			echo "    };"
		fi
		echo "}"
	done
}

# Schedule periodic list sync via cron (uci bird.global.sync_cron/cron_expr).
setup_cron() {
	local on expr
	on=$(get_cfg sync_cron)
	[ "$on" = "1" ] || return 0
	expr=$(get_cfg cron_expr)
	[ -n "$expr" ] || expr="0 3 * * *"
	[ -d /etc/crontabs ] || mkdir -p /etc/crontabs
	grep -q 'bird-sync.sh' /etc/crontabs/root 2>/dev/null || \
		echo "$expr /usr/sbin/bird-sync.sh >/dev/null 2>&1" >> /etc/crontabs/root
}

start_service() {
	# Respect the UCI master enable switch (bird.global.enabled).
	[ "$(get_cfg enabled)" = "0" ] && {
		echo "BIRD antifilter is disabled in UCI (bird.global.enabled=0)"
		return 1
	}
	setup_cron
	start_instance
}

stop_service() {
	procd_kill bird2-antifilter 2>/dev/null
	rm -f "$BIRD_PID"
	return 0
}

reload_service() {
	# Regenerate the config and reload the daemon without a full restart.
	start_instance
	procd_send_signal bird2-antifilter SIGHUP 2>/dev/null
	return 0
}

start_instance() {
	local rid
	# VIA iface used by sync to build route lines.
	VIA_IFACE=$(get_cfg via_interface)
	[ -z "$VIA_IFACE" ] && VIA_IFACE="awg0"

	rid=$(resolve_router_id)

	# Ensure a first sync so the rsc includes are meaningful.
	[ -c "$BIRDC" ] || [ -s "$BIRDC" ] || true
	[ -n "$(ls "$RSC_DIR"/*.rsc 2>/dev/null)" ] || /usr/sbin/bird-sync.sh >/dev/null 2>&1

	# Regenerate rsc from custom lists if not present.
	[ -d "$RSC_DIR" ] || mkdir -p "$RSC_DIR"
	[ -d "$LIST_DIR" ] || mkdir -p "$LIST_DIR"
	>&2 echo "bird: router id = $rid"

	cat > "$BIRD_CONF" <<-EOF
		log syslog all;
		router id ${rid};

		protocol device {
		}

		protocol direct {
		    disabled;
		    ipv4;
		    ipv6;
		}

		$(gen_kernel)

		$(gen_static)
	EOF

	# Append BGP peers.
	gen_bgp_peer >> "$BIRD_CONF"

	procd_open_instance bird2-antifilter
	procd_set_param command "$BIRD" -c "$BIRD_CONF" -f -P "$BIRD_PID"
	# Explicit procd respawn (threshold 3600s, timeout 5s, retry 5): retry
	# a few times, but do not crash-loop forever when the config is invalid.
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

extra_command "sync" "Run list sync now and reload BIRD"
sync() {
	/usr/sbin/bird-sync.sh
	procd_send_signal bird2-antifilter SIGHUP 2>/dev/null
}

extra_command "status" "Show BIRD runtime status"
status() {
	$BIRDC show protocols 2>&1
}